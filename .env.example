# Mobile app environment variables
# Copy this file to `.env` and update values for your machine.

# Development API URL used by simulators/emulators
# - Android emulator (AVD): use http://10.0.2.2:8000
# - Genymotion emulator: use http://10.0.3.2:8000
# - iOS simulator: use http://localhost:8000
# - Physical device: use your PC IP (e.g. http://192.168.1.17:8000)
API_URL_DEV=http://10.0.2.2:8000

# Optional: override when testing on a physical device
API_URL_DEV_PHYSICAL=http://192.168.1.17:8000

# Production API base URL
API_URL_PROD=https://your-production-url.com/api

# Enable verbose API request/response logging in development (true|false)
# - Set to true to see request URL, method, params/body and truncated responses in Metro logs
ENABLE_API_DEBUG=false

# Misc (future use)
# ENABLE_MOCKS=false
# FEATURE_FLAG_X=true

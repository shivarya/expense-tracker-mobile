{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "API_URL_DEV": "https://shivarya.dev/expense_tracker",
        "API_URL_PROD": "https://shivarya.dev/expense_tracker",
        "ENABLE_API_DEBUG": "false",
        "GOOGLE_CLIENT_ID": "473762682694-temn315hduj5tmvprin69srkrr5kdqpl.apps.googleusercontent.com"
      }
    }
  }
}

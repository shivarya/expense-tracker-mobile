{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-mobile",
    "version": "2.7.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.shivarya.expensetracker",
      "buildNumber": "5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "dev.shivarya.expensetracker",
      "versionCode": 40,
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-iap",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Expense Tracker with Face ID."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://shivarya.dev/expense_tracker",
      "googleClientId": "473762682694-temn315hduj5tmvprin69srkrr5kdqpl.apps.googleusercontent.com",
      "apiUrlDev": "http://10.0.2.2:8000",
      "apiUrlProd": "https://shivarya.dev/expense_tracker",
      "enableApiDebug": true,
      "eas": {
        "projectId": "1497933e-c12f-40b0-9cfa-8f2570b53fd0"
      }
    }
  }
}

{
  "name": "expense-tracker-mobile",
  "version": "2.7.3",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:free-space": "powershell -ExecutionPolicy Bypass -File ./scripts/free-emulator-space.ps1",
    "build:production:local": "npm run version:bump:production && cd android && gradlew.bat assembleRelease",
    "build:production:local:no-bump": "npm run version:sync:config && cd android && gradlew.bat assembleRelease",
    "build:production:local:aab": "npm run version:bump:production && cd android && gradlew.bat bundleRelease && cd .. && node ./scripts/print-aab-path.js",
    "build:production:local:aab:no-bump": "npm run version:sync:config && cd android && gradlew.bat bundleRelease && cd .. && node ./scripts/print-aab-path.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "version:sync:config": "node ./scripts/sync-app-version.js",
    "version:bump:production": "node ./scripts/bump-release-version.js && node ./scripts/sync-app-version.js",
    "build:production": "npm run version:bump:production && npx eas build --platform android --profile production --non-interactive --no-wait"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-google-signin/google-signin": "^13.3.1",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@react-navigation/stack": "^7.6.16",
    "axios": "^1.7.0",
    "date-fns": "^3.0.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.7",
    "expo-iap": "^4.3.1",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "^0.32.16",
    "expo-screen-capture": "~8.0.9",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-get-sms-android": "^2.0.0",
    "react-native-gifted-charts": "^1.4.0",
    "react-native-linear-gradient": "^2.8.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^9.13.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
